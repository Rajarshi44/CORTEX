# Dependencies
node_modules/
.venv/
venv/
env/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/

# Next.js / Frontend build
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Large Data, Models & Databases
backend/data/*.db
backend/data/*.db-*
backend/data/cache/
backend/data/icij/
backend/data/models/
cortex-enterprise/backend/data/*.db
cortex-enterprise/backend/data/*.db-*
cortex-enterprise/backend/data/cache/
cortex-enterprise/backend/data/icij/
cortex-enterprise/backend/data/models/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Large ML model files (always exclude regardless of location)
*.onnx
*.bin
*.pt
*.safetensors

# Binaries & Executables
*.exe
*.dll
*.so
*.dylib

# Environment variables & secrets
.env
.env*.local
backend/.env
frontend-next/.env
frontend-next/.env*.local
!.env.example
!backend/.env.example

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db

# Agent / Tool local files & caches
.impeccable/
.claude/settings.local.json

# Purge/repair backups (data artifacts, regenerated on demand)
backend/data/purge-backup-*.json
backend/data/export/
